{
  "name": "johanneskolb/nextfleet",
  "description": "Nextcloud app for vehicle fleet management",
  "license": "AGPL-3.0-or-later",
  "type": "project",
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.1.31"
    }
  },
  "prefer-stable": true,
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "nextcloud/coding-standard": "^1.3",
    "nextcloud/ocp": "dev-stable31",
    "phpunit/phpunit": "^10.5",
    "vimeo/psalm": "^5.26"
  },
  "autoload": {
    "psr-4": {
      "OCA\\NextFleet\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\NextFleet\\Tests\\": "tests/",
      "OCP\\": "vendor/nextcloud/ocp/OCP/"
    }
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "psalm": "psalm --threads=1",
    "test": "phpunit",
    "lint": [
      "@cs:check",
      "@psalm"
    ]
  }
}
